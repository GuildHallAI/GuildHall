NODE_ENV=development
PORT=3001
TRUST_PROXY=1

# Local Postgres. Start it with `docker compose up -d` from backend/.
DATABASE_URL=postgresql://guildhall:guildhall@127.0.0.1:5432/guildhall

# Start on devnet. Use a dedicated RPC provider for production.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed

# Add these after the Anchor program and supported devnet mints are chosen.
# GUILDHALL_PROGRAM_ID=
# USDC_MINT=
# USDT_MINT=

# Used when wallet sign-in, encrypted private job details, and cron tasks are added.
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:3000
AUTH_TOKEN_PEPPER=
DATA_ENCRYPTION_KEY=
CRON_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
