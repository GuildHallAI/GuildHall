NODE_ENV=development
PORT=3001
TRUST_PROXY=1

# Local Postgres. Start it with `docker compose up -d` from backend/.
DATABASE_URL=postgresql://guildhall:guildhall@127.0.0.1:5432/guildhall

# Start on devnet. Use a dedicated RPC provider for production.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed

# Configure the canonical stablecoin mint addresses for the selected cluster.
USDC_MINT=
USDT_MINT=

# Wallet sign-in challenge and opaque session-token hashing.
AUTH_DOMAIN=guildhallai.com
AUTH_URI=https://guildhallai.com
AUTH_TOKEN_PEPPER=

# Encryption key for commission EOA private keys and private commission data.
DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Shared secret for authenticated scheduled operations.
CRON_SECRET=
