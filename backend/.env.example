NODE_ENV=development
PORT=3001
TRUST_PROXY=1
RECONCILE_INTERVAL_MS=60000

# Local Postgres. Start it with `docker compose up -d` from backend/.
DATABASE_URL=postgresql://guildhall:guildhall@127.0.0.1:5432/guildhall

# Start on devnet. Use a dedicated RPC provider for production.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
# Base58 encoded 64-byte secret key for the backend transaction fee payer.
# Either private-key variable is accepted; if both are present they must match.
GAS_PAYER_PRIVATE_KEY=
GUILDHALL_GAS_WALLET_PRIVATE_KEY=
GUILDHALL_GAS_WALLET_PUBLIC_KEY=
# Commission fees are 2%, allocated 80% to workers, 10% to treasury,
# 5% to stakers, and 5% burned. Charter agent-token fees also route 30% to treasury.
# Configure valid Solana wallet addresses for the fee recipients.
WORKER_FEE_WALLET=
TREASURY_WALLET=
STAKER_FEE_WALLET=
# Optional $GHALL Token-2022 evaluator capacity boost (disabled until configured).
GHALL_MINT=
GHALL_EVALUATOR_BOOST_THRESHOLD_ATOMIC=0
GHALL_EVALUATOR_MAX_CAPACITY_BPS=10000
GHALL_LISTING_MINIMUM_STAKE_ATOMIC=0
GHALL_BOUNTY_PRIORITY_THRESHOLD_ATOMIC=0
GHALL_GOVERNANCE_MIN_QUORUM_ATOMIC=0
GHALL_GOVERNANCE_VOTING_DAYS=7
# Three or more OpenAI-compatible jurors are used at the final Tribunal tier.
# Example shape (put real keys only in the backend secret store):
TRIBUNAL_AI_JURORS=[]
# Optional USDC fee for each Tribunal appeal; successful appeals are refunded.
TRIBUNAL_APPEAL_FEE_ATOMIC=0
# Uncast Panel seats are reassigned after this vote window.
TRIBUNAL_PANEL_VOTE_HOURS=24
# GHALL holders meeting this balance threshold receive the configured appeal-fee discount.
GHALL_TRIBUNAL_FEE_DISCOUNT_THRESHOLD_ATOMIC=0
GHALL_TRIBUNAL_FEE_DISCOUNT_BPS=0
# OAuth 2.0 user-context token used to publish funded Bounty Blinks.
X_USER_ACCESS_TOKEN=
# X API user ID for polling mentions, and OAuth 2.0 app settings for wallet-linked authors.
X_BOT_USER_ID=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Register this exact callback URL in the X developer app.
X_OAUTH_REDIRECT_URI=https://api.guildhallai.com/v1/bounty-x/account/callback
# X-originated Bounties use this entrant bond and entry cap.
X_BOUNTY_ENTRY_BOND_ATOMIC=1000000
X_BOUNTY_MAX_ENTRIES=20
# Defaults to AUTH_URI. The frontend Actions route proxies to the backend because
# browser CORS is handled by the frontend server stack.
GUILDHALL_ACTIONS_BASE_URL=

# Configure the canonical stablecoin mint addresses for the selected cluster.
USDC_MINT=
USDT_MINT=
AGENT_REGISTRY_PROGRAM_ID=
AGENT_REGISTRY_ATOM_PROGRAM_ID=
# Surety starts at 1%; historical Tribunal overturn rates add up to 1% at a 100% rate.
SURETY_BASE_PREMIUM_BPS=100
SURETY_OVERTURN_RISK_BPS=100
SURETY_MAX_PREMIUM_BPS=500

# Charter tokens use a fixed Token-2022 supply. Creator tokens vest over compliant weeks.
CHARTER_TOTAL_SUPPLY_TOKENS=1000000000
CHARTER_CREATOR_SHARE_BPS=2000
CHARTER_VESTING_WEEKS=52
CHARTER_SLA_MINIMUM_ON_TIME_BPS=9000
CHARTER_INCOME_BUYBACK_BPS=500
CHARTER_LAUNCH_FEE_ATOMIC=0
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=
JUPITER_API_KEY=
PROVING_GROUND_SOL_USD_FEED_ID=
PROVING_GROUND_INITIAL_CAPITAL_ATOMIC=1000000000
PROVING_GROUND_CHALLENGE_FEE_ATOMIC=25000000
PROVING_GROUND_DURATION_DAYS=14
PROVING_GROUND_TARGET_BPS=800
PROVING_GROUND_DAILY_DRAWDOWN_BPS=500
PROVING_GROUND_TOTAL_DRAWDOWN_BPS=1000

# Wallet sign-in challenge and opaque session-token hashing.
AUTH_DOMAIN=guildhallai.com
AUTH_URI=https://guildhallai.com
AUTH_TOKEN_PEPPER=

# Encryption key for commission EOA private keys and private commission data.
DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Optional private image storage for commission deliverables. Configure all three together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Shared secret for authenticated scheduled operations.
# Use a random secret of at least 24 characters for scheduled internal requests.
CRON_SECRET=
