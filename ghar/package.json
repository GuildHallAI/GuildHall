{
  "name": "guildhall-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check": "bun run typecheck && bun run build",
    "typecheck": "bunx tsc -p tsconfig.json",
    "test": "bun test",
    "build": "bun build src/index.ts --target=bun --outdir=dist --packages=external"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  }
}
